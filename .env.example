PORT=3000
CONVERTKIT_API_KEY=your_convertkit_api_key_here
NODE_ENV=development

# CORS Configuration
# Comma-separated list of allowed origins for CORS
# Leave empty to allow all origins (development only)
# Supports wildcards for PR previews and subdomains
# Examples:
#   Local only: http://localhost:3000,http://localhost:5173
#   Production: https://myapp.vercel.app,https://myapp.railway.app
#   With PR previews: https://myapp.vercel.app,https://*.vercel.app,https://*.railway.app
#   With custom domain: https://*.crucialsurvival.com,https://crucial-survival-website.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,https://crucial-survival-website.vercel.app,https://*.vercel.app,https://*.up.railway.app,https://*.crucialsurvival.com
